# SchoolBell firmware configuration.
#
# Copy this file to .env and adjust it. scripts/gen-config.sh renders the values
# into firmware/SchoolBell/app_config.h before compiling, because the ESP32
# cannot read files from the build machine at runtime. .env is git-ignored.
# scripts/build-firmware.sh runs the generator automatically.

# ------------------------------- Access point -------------------------------

# Wi-Fi network created by the device (max 32 bytes).
AP_SSID=SchoolBell

# WPA2 password, 8..63 characters. Leave empty for an open network.
AP_PASSWORD=bell12345

# Wi-Fi channel, 1..13 (channel 14 is not allowed in most regions).
AP_CHANNEL=6

# Maximum number of concurrent clients, 1..8.
AP_MAX_CLIENTS=4

# -------------------------------- API access --------------------------------

# Clients must send "X-Token: <value>" or "?token=<value>".
# Leave empty to disable authentication.
API_TOKEN=

# ------------------------------- GPIO wiring --------------------------------

# Relay input pin, active LOW.
PIN_RELAY=26
# KY-029 status LED pins.
PIN_LED_GREEN=27
PIN_LED_RED=25
# DS3231 RTC I2C pins.
PIN_I2C_SDA=21
PIN_I2C_SCL=22

# KY-029 variant:
#   false = common cathode, common pin to GND, die lit by HIGH
#   true  = common anode,   common pin to 3V3, die lit by LOW
LED_ACTIVE_LOW=false
